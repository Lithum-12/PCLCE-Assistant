<local:MyPageRight x:Class="PCL.Assistant.PageAssistantHome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d">
    <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
        <StackPanel Margin="20,17">
            <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19"
                       UseLayoutRounding="True" SnapsToDevicePixels="True"
                       Foreground="{DynamicResource ColorBrush3}"
                       Text="{DynamicResource Assistant.Home.Title}" />
            <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
            <TextBlock Margin="10,10,10,0" TextWrapping="Wrap"
                       Text="{DynamicResource Assistant.Home.Description}" />
            <WrapPanel Margin="10,20,10,5" HorizontalAlignment="Center" Orientation="Horizontal">
                <local:MyButton Height="35" MinWidth="130" Padding="12,0" ColorType="Highlight"
                                Text="{DynamicResource Assistant.Home.Start}" Click="BtnStart_Click" />
            </WrapPanel>
        </StackPanel>
    </local:MyCard>
</local:MyPageRight>
