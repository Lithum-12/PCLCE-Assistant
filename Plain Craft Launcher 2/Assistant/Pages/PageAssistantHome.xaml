<local:MyPageRight x:Class="PCL.Assistant.PageAssistantHome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:assistant="clr-namespace:PCL.Assistant"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d">
    <Grid Margin="25,25,25,18">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MyCard Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}"
                           Text="{DynamicResource Assistant.Home.Title}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" TextWrapping="Wrap"
                           Text="{DynamicResource Assistant.Home.Description}" />
            </StackPanel>
        </local:MyCard>

        <assistant:AssistantInputBar x:Name="InputBar" Grid.Row="1" />
    </Grid>
</local:MyPageRight>
