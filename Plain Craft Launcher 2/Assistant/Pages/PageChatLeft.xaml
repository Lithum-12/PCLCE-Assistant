<local:MyPageLeft x:Class="PCL.Assistant.PageChatLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d" d:DesignWidth="152">
    <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanItem" Margin="0,12,0,0" Orientation="Vertical">
            <local:MyListItem x:Name="ItemNewChat" IsScaleAnimationEnabled="False" MinPaddingRight="20" Height="38"
                              VerticalAlignment="Top" Title="{DynamicResource Assistant.Left.NewChat}" Type="Clickable"
                              Click="NewChatClick" LogoScale="0.9" SvgIcon="lucide/circle-plus" />
            <TextBlock x:Name="LabDraftsHeader" Text="{DynamicResource Assistant.Left.Drafts}" Margin="13,13,5,3"
                       Opacity="0.6" FontSize="12" Visibility="Collapsed" />
            <StackPanel x:Name="PanDrafts" />
            <TextBlock Text="{DynamicResource Assistant.Left.HistoryCategory}" Margin="13,13,5,3" Opacity="0.6" FontSize="12" />
            <StackPanel x:Name="PanHistory" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>
