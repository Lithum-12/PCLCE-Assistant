<local:MyPageLeft x:Class="PCL.Assistant.PageChatLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d" d:DesignWidth="152">
    <StackPanel x:Name="PanItem" Margin="0,12,0,0" Orientation="Vertical">
        <TextBlock Text="{DynamicResource Assistant.Left.Category}" Margin="13,5,5,3" Opacity="0.6" FontSize="12" />
        <local:MyListItem x:Name="ItemChat" IsScaleAnimationEnabled="False" Tag="0" MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top" Title="{DynamicResource Assistant.Left.Chat}" Type="RadioBox" />
    </StackPanel>
</local:MyPageLeft>
