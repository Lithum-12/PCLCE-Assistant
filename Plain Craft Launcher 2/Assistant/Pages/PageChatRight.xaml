<local:MyPageRight x:Class="PCL.Assistant.PageChatRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:assistant="clr-namespace:PCL.Assistant"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d" PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MyScrollViewer x:Name="PanBack" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMessages" Margin="25,20,25,10">
                <TextBlock x:Name="TextEmpty" Text="{DynamicResource Assistant.Chat.Empty}" TextWrapping="Wrap"
                           Opacity="0.6" FontSize="13" Margin="0,0,0,10" />
            </StackPanel>
        </local:MyScrollViewer>

        <assistant:AssistantInputBar x:Name="InputBar" Grid.Row="1" Margin="25,0,25,18" />
    </Grid>
</local:MyPageRight>
