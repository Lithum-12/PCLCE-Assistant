<local:MyPageRight x:Class="PCL.Assistant.PageChatRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:assistant="clr-namespace:PCL.Assistant"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d" PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MyScrollViewer x:Name="PanBack" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMessages" Margin="25,20,25,10" />
        </local:MyScrollViewer>

        <local:MyCard x:Name="TextEmpty" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="40" MaxWidth="560" IsHitTestVisible="False">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}"
                           Text="{DynamicResource Assistant.Home.Title}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" TextWrapping="Wrap"
                           Text="{DynamicResource Assistant.Chat.Empty}" />
            </StackPanel>
        </local:MyCard>

        <assistant:AssistantInputBar x:Name="InputBar" Grid.Row="1" Margin="25,0,25,18" />
    </Grid>
</local:MyPageRight>
