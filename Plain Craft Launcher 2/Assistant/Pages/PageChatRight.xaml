<local:MyPageRight x:Class="PCL.Assistant.PageChatRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d" PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MyScrollViewer x:Name="PanBack" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMessages" Margin="25,20,25,10">
                <TextBlock x:Name="TextEmpty" Text="{DynamicResource Assistant.Chat.Empty}" TextWrapping="Wrap"
                           Opacity="0.6" FontSize="13" Margin="0,0,0,10" />
            </StackPanel>
        </local:MyScrollViewer>

        <Grid Grid.Row="1" Margin="25,0,25,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:MyIconTextButton x:Name="BtnInstance" Grid.Column="0" Margin="0,0,10,7" VerticalAlignment="Bottom"
                                    Text="{DynamicResource Assistant.Chat.SelectInstance}"
                                    SvgIcon="lucide/package" Click="BtnInstance_Click" />

            <local:MyCard Grid.Column="1" MinHeight="40" HasMouseAnimation="False">
                <Grid>
                    <local:MyTextBox x:Name="TextChatInput" HasBackground="False" BorderThickness="0"
                                     Padding="34,9,74,9" MinHeight="40" MaxHeight="140" FontSize="13.5"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     HintText="{DynamicResource Assistant.Chat.InputHint}"
                                     KeyDown="TextChatInput_KeyDown" />
                    <svgIcon:SvgIcon Width="14" Height="14" Margin="14,11,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" IsHitTestVisible="False"
                                     IconBrush="{DynamicResource ColorBrush1}" Icon="lucide/sparkles" />
                    <local:MyButton x:Name="BtnSend" Width="60" Height="28" Margin="0,0,6,0" ColorType="Highlight"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Text="{DynamicResource Assistant.Chat.Send}" Click="BtnSend_Click" />
                </Grid>
            </local:MyCard>

            <local:MyComboBox x:Name="ComboModel" Grid.Column="2" Width="180" Margin="10,0,0,0"
                              VerticalAlignment="Bottom" SelectionChanged="ComboModel_SelectionChanged" />
        </Grid>
    </Grid>
</local:MyPageRight>
